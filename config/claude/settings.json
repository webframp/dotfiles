{
  "env": {
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/claude-code-status/statusline.sh"
  },
  "enabledPlugins": {
    "impeccable@impeccable": false,
    "claude-code-status@webframp": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "honeycomb-plugins": {
      "source": {
        "source": "github",
        "repo": "honeycombio/agent-skill"
      }
    },
    "webframp": {
      "source": {
        "source": "github",
        "repo": "webframp/claude-code-status"
      }
    }
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
